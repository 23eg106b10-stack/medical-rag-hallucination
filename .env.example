# ── Secrets & configuration (copy to .env and fill in) ──────────────────────
# !! DO NOT commit .env to version control !!

# Fields are added here only in the milestone that first needs them. Do not
# front-load retrieval/generation/verification config before those milestones
# begin — see engineering standard #7 (dependency management).

# --- Environment / Logging ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Hugging Face Hub ---
# Needed as soon as any milestone downloads a checkpoint (MedCPT,
# verifier, or Llama). Present now because it's provider-agnostic
# infrastructure, not tied to one specific model choice.
HF_TOKEN=

# --- Data Paths ---
CORPUS_DIR=data/corpus
PUBMEDQA_DIR=data/pubmedqa
MEDMCQA_DIR=data/medmcqa
ANNOTATIONS_DIR=data/annotations

# --- Outputs ---
OUTPUTS_DIR=outputs

# --- Corpus Construction (M3.1.1) ---
# Contact email required by NCBI E-utilities usage policy. api_key is
# optional but raises the allowed request rate.
NCBI_EMAIL=
NCBI_API_KEY=
# Filename of the PubMedQA release file under PUBMEDQA_DIR.
PUBMEDQA_FILENAME=ori_pqal.json