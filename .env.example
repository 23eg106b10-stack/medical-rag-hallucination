# ── Secrets & configuration (copy to .env and fill in) ──────────────────────
# !! DO NOT commit .env to version control !!

# --- Environment / Logging ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Hugging Face Hub ---
# Required for gated models (Llama-3.1-8B-Instruct). Optional but
# recommended for MedCPT / PubMedBERT to avoid anonymous rate limits.
HF_TOKEN=

# --- Dense Retrieval: MedCPT (§4, §5.2) ---
MEDCPT_QUERY_ENCODER_NAME=ncbi/MedCPT-Query-Encoder
MEDCPT_ARTICLE_ENCODER_NAME=ncbi/MedCPT-Article-Encoder
MEDCPT_EMBEDDING_DIMENSION=768

# --- Generation LLM (§4, §6) ---
GENERATION_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
GENERATION_MODEL_REVISION=
GENERATION_QUANTIZATION_BITS=4

# --- Verifier (§4, §7.2) ---
VERIFIER_MODEL_NAME=pritamdeka/PubMedBERT-MNLI-MedNLI
VERIFIER_MODEL_REVISION=

# --- Retrieval tuning (§5.3) ---
RETRIEVAL_BM25_TOP_K=20
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_FUSED_TOP_K=5
RETRIEVAL_MIN_SIMILARITY_THRESHOLD=0.0

# --- Confidence calibration (§8) ---
CALIBRATION_SPLIT_SIZE=20
HOLDOUT_SPLIT_SIZE=80

# --- Index Paths ---
FAISS_INDEX_PATH=index/artifacts/faiss_flat.index
BM25_INDEX_PATH=index/artifacts/bm25.pkl

# --- Data Paths ---
CORPUS_DIR=data/corpus
PUBMEDQA_DIR=data/pubmedqa
MEDMCQA_DIR=data/medmcqa
ANNOTATIONS_DIR=data/annotations

# --- Outputs ---
OUTPUTS_DIR=outputs